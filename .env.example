# Copy this file to .env and fill in your Supabase project values.
# Supabase dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Google + Discord login
# ---------------------
# No extra variables are needed in this file. The Google and Discord
# Client ID / Client Secret are entered in the Supabase dashboard
# (Authentication → Sign In / Providers), NOT here — never put them in .env.
#
# Redirect (callback) URL to paste into Google Cloud and Discord:
#   https://your-project.supabase.co/auth/v1/callback
#
# Supabase → Authentication → URL Configuration:
#   Site URL:       your live site address
#   Redirect URLs:  your live site + /account, and the preview site + /account
